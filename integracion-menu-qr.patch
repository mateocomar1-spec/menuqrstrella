diff --git a/scripts/verify-menu-qr.mjs b/scripts/verify-menu-qr.mjs
new file mode 100644
index 0000000..7a69406
--- /dev/null
+++ b/scripts/verify-menu-qr.mjs
@@ -0,0 +1,24 @@
+import fs from 'node:fs';
+import assert from 'node:assert/strict';
+const root=process.argv.includes('--source')?'site':'dist';
+const html=fs.readFileSync(`${root}/menu-qr/index.html`,'utf8');
+const schemas=[...html.matchAll(/<script type="application\/ld\+json">(.*?)<\/script>/gs)].map(m=>JSON.parse(m[1]));
+assert(schemas.some(s=>s['@type']==='Service'&&s.description.includes('30000 ARS')&&s.description.includes('80000 ARS')),'Service describe ambos importes');
+const faq=schemas.find(s=>s['@type']==='FAQPage');
+const visible=[...html.matchAll(/<details><summary>(.*?)<span aria-hidden="true">\+<\/span><\/summary><p>(.*?)<\/p><\/details>/gs)];
+assert.equal(visible.length,14,'14 preguntas visibles');assert.equal(faq.mainEntity.length,visible.length);
+visible.forEach((m,i)=>{assert.equal(m[1],faq.mainEntity[i].name);assert.equal(m[2],faq.mainEntity[i].acceptedAnswer.text);});
+const main=html.match(/<main id="main".*?<\/main>/s)[0];
+assert(!/piccolina|picolina|Google Sheets|planilla del negocio/i.test(main),'Sin nombre del cliente ni oferta anterior');
+assert(main.includes('$30.000')&&main.includes('$80.000')&&main.includes('50 productos'),'Importes y carga inicial');
+assert(html.includes('class="site-header"')&&html.includes('class="footer"'),'Marco original de la web');
+assert(html.includes('/assets/menu-qr/menu-qr.css'),'CSS exclusivo de esta ruta');
+for(const image of ['menu-ejemplo.png','panel-ejemplo.png'])assert(fs.statSync(`${root}/assets/menu-qr/${image}`).size>0,'Capturas existentes');
+for(const match of main.matchAll(/href="#([^"]+)"/g))assert(html.includes(`id="${match[1]}"`),`Ancla ${match[1]}`);
+if(process.argv.includes('--preview')){
+ assert(html.includes('content="noindex,nofollow"'),'Preview no indexable');
+ assert(!html.includes('/assets/analytics.js'),'Sin Analytics en preview');
+ assert(fs.readFileSync(`${root}/robots.txt`,'utf8').includes('Disallow: /'),'Robots preview');
+ assert(fs.readFileSync(`${root}/_headers`,'utf8').includes('X-Robots-Tag: noindex, nofollow'),'Cabecera preview');
+}
+console.log(`OK /menu-qr/: 14 FAQ coherentes, Service, precios, carga inicial, capturas anónimas, enlaces y ${process.argv.includes('--preview')?'preview sin indexación ni Analytics':'contenido'}.`);
